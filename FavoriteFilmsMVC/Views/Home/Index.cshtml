@model IEnumerable<FavoriteFilmsMVC.Models.Movie>

@{
    ViewData["Title"] = "Главная - ТОП 10 Фильмов";
}

<div class="text-center mb-5">
    <h1 class="display-4 fw-bold text-primary">ТОП-10 Лучших Фильмов</h1>
    <p class="lead text-muted">Коллекция фильмов из базы данных SQL Server</p>
</div>

<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
    @foreach (var movie in Model)
    {
        <div class="col">
            <div class="card h-100 shadow-sm border-0 rounded-3 overflow-hidden">
                <img src="@movie.PosterUrl" class="card-img-top" alt="@movie.Title" style="height: 380px; object-fit: cover;">
                <div class="card-body d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="badge bg-secondary">@movie.Genre</span>
                        <span class="fw-bold text-muted">@movie.ReleaseYear</span>
                    </div>
                    <h5 class="card-title fw-bold">@movie.Title</h5>
                    <p class="card-text text-muted small mb-2"><strong>Режиссер:</strong> @movie.Director</p>
                    <p class="card-text flex-grow-1">@movie.Description</p>
                </div>
            </div>
        </div>
    }
</div>