@model FavoriteFilmsMVC.Models.Movie

<h2>Додати новий фільм</h2>

<form asp-action="Create" method="post" class="styled-form">
    <div asp-validation-summary="ModelOnly" class="alert-summary"></div>

    <div class="form-group">
        <label asp-for="Title"></label>
        <input asp-for="Title" class="form-control" />
        <span asp-validation-for="Title" class="validation-message"></span>
    </div>

    <div class="form-group">
        <label asp-for="Genre"></label>
        <input asp-for="Genre" class="form-control" />
        <span asp-validation-for="Genre" class="validation-message"></span>
    </div>

    <div class="form-group">
        <label asp-for="ReleaseYear"></label>
        <input asp-for="ReleaseYear" class="form-control" />
        <span asp-validation-for="ReleaseYear" class="validation-message"></span>
    </div>

    <div class="form-group">
        <label asp-for="Rating"></label>
        <input asp-for="Rating" class="form-control" />
        <span asp-validation-for="Rating" class="validation-message"></span>
    </div>
    <div class="form-group">
        <label asp-for="Director"></label>
        <input asp-for="Director" class="form-control" />
        <span asp-validation-for="Director" class="validation-message"></span>
    </div>

    <div class="form-group">
        <label asp-for="PosterUrl"></label>
        <input asp-for="PosterUrl" class="form-control" placeholder="https://..." />
        <span asp-validation-for="PosterUrl" class="validation-message"></span>
    </div>

    <button type="submit" class="btn-submit">Зберегти</button>
</form>

@section Scripts {
    @* Клиентская валидация *@
    <partial name="_ValidationScriptsPartial" />
}