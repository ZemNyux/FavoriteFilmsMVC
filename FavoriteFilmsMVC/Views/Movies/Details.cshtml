@model FavoriteFilmsMVC.Models.Movie

<h2>Детали фильма</h2>

<div class="card mb-3" style="max-width: 600px;">
    <div class="row g-0">
        <div class="col-md-4">
            <img src="@Model.PosterUrl" 
                 alt="@Model.Title" 
                 class="img-fluid rounded" 
                 referrerpolicy="no-referrer" />
        </div>
        <div class="col-md-8">
            <div class="card-body">
                <h5 class="card-title">@Model.Title (@Model.ReleaseYear)</h5>
                <p class="card-text"><strong>Режиссёр:</strong> @Model.Director</p>
                <p class="card-text"><strong>Жанр:</strong> @Model.Genre</p>
                <p class="card-text">@Model.Description</p>
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Изменить</a>
                <a asp-action="Index" class="btn btn-secondary">Назад</a>

            </div>
        </div>
    </div>
</div>